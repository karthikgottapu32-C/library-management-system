# PostgreSQL Database URL (Render PostgreSQL or any standard provider)
# Render Internal: postgresql://library_user:PASSWORD@dpg-xxxxxx-a:5432/library_db
# Render External: postgresql://library_user:PASSWORD@dpg-xxxxxx-a.singapore-postgres.render.com:5432/library_db
DATABASE_URL=postgresql://postgres:password@localhost:5432/library_db

# Alternative discrete connection parameters:
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=password
# PGDATABASE=library_db

PORT=5000
PGPOOL_MAX=5
PGCONNECT_TIMEOUT_MS=10000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
